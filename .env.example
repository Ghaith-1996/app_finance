# Supabase (required for auth and database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# REQUIRED for Python news ingestion (server-side only — never expose to the browser)
# Project Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Legacy Node-only provider toggle (not used by the Python ingest worker)
NEWS_PROVIDER=marketaux
MARKETAUX_API_KEY=your-marketaux-api-key

# AI provider: openrouter | openai (default) | anthropic
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=your-openrouter-api-key
# Default model: StepFun Step 3.5 Flash (free) — good fit for finance/news enrichment
# OPENROUTER_MODEL=stepfun/step-3.5-flash:free
# Optional (recommended by OpenRouter for rankings)
# OPENROUTER_HTTP_REFERER=https://your-site.example
# OPENROUTER_APP_NAME=Portfolio Signal

# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Cron: unattended market-news ingestion
# Used as Bearer token for POST /api/news/cron
# CRON_SECRET=your-cron-secret
#
# Recommended scheduler cadence (set in deployment config, not here):
#   weekdays 06:00-20:00 America/Toronto → every 30 min
#   nights / weekends                    → every 2 hours

# --- Python news ingestion worker (EDGAR + NewsAPI + GNews package) ---
# REQUIRED: SEC fair-access policy — use your real name and email
EDGAR_IDENTITY=Your Name yourname@example.com

# REQUIRED for global market/business headlines (newsapi-python)
NEWSAPI_KEY=your-newsapi-org-api-key

# GNews uses the Python `gnews` package and does not require an API key.

# Optional: override default cache dir (default: <project>/.edgar_data)
# EDGAR_LOCAL_DATA_DIR=D:/path/to/writable/edgar-cache
