# Required: Supabase auth and database
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Required: server-side Supabase access for ingestion and privileged writes.
# Never expose this key to the browser.
# Supabase dashboard -> Project Settings -> API -> service_role
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Required: SEC fair-access identity for EDGAR requests.
EDGAR_IDENTITY=Your Name yourname@example.com

# Required: global market/business headlines for the Python news worker.
NEWSAPI_KEY=your-newsapi-org-api-key

# Optional: unattended market-news ingestion endpoint auth.
# Used as Bearer token for POST /api/news/cron
# CRON_SECRET=your-random-cron-secret
#
# Recommended scheduler cadence (set in deployment config, not here):
#   weekdays 06:00-20:00 America/Toronto -> every 30 min
#   nights / weekends                    -> every 2 hours

# Required for watchlist search/quotes. Also used for targeted company-news refresh.
# FINNHUB_API_KEY=your-finnhub-api-key

# Optional: watchlist detail dashboard (quote, profile, price chart).
# TWELVE_DATA_API_KEY=your-twelve-data-api-key

# Optional: real AI responses. If no provider key is configured, the app falls back
# to its stub provider for summaries, chat, and insights.
# Provider options: azure | openai | anthropic | openrouter
# Default when AI_PROVIDER is unset: openai
# AI_PROVIDER=azure
#
# Azure OpenAI via the Responses API
# `AZURE_OPENAI_MODEL` should be your deployment name for GPT-5.2.
# You can set `AZURE_OPENAI_BASE_URL` either to:
#   https://YOUR-RESOURCE.openai.azure.com
# or:
#   https://YOUR-RESOURCE.openai.azure.com/openai/v1/
# AZURE_OPENAI_API_KEY=your-azure-openai-api-key
# AZURE_OPENAI_BASE_URL=https://your-resource.openai.azure.com
# AZURE_OPENAI_MODEL=gpt-5.2
# Optional: minimal | low | medium | high
# AZURE_OPENAI_REASONING_EFFORT=medium
#
# OpenRouter
# OPENROUTER_API_KEY=your-openrouter-api-key
# OPENROUTER_MODEL=stepfun/step-3.5-flash:free
# OPENROUTER_HTTP_REFERER=https://your-site.example
# OPENROUTER_APP_NAME=Portfolio Signal
# NEXT_PUBLIC_SITE_URL=https://your-site.example
#
# OpenAI
# OPENAI_API_KEY=your-openai-api-key
#
# Anthropic
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional: override default cache dir (default: <project>/.edgar_data)
# EDGAR_LOCAL_DATA_DIR=D:/path/to/writable/edgar-cache

# Legacy / unused in the current app flow
# NEWS_PROVIDER=marketaux
# MARKETAUX_API_KEY=your-marketaux-api-key

# GNews uses the Python `gnews` package and does not require an API key.
